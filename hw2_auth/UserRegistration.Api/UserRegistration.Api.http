@UserRegistration.Api_HostAddress = http://localhost:5147

@login = student
@password = <тестовый пароль>
@userId = 1
@createdDate = <createdDate из ответа>
@updatedDate = <updatedDate после редактирования>

###
POST {{UserRegistration.Api_HostAddress}}/api/users
Content-Type: application/json

{
  "login": "{{login}}",
  "password": "{{password}}",
  "firstName": "Анна",
  "lastName": "Иванова"
}

###
POST {{UserRegistration.Api_HostAddress}}/api/users
Content-Type: application/json

{
  "login": "",
  "password": "{{password}}"
}

###
POST {{UserRegistration.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "login": "{{login}}",
  "password": "{{password}}"
}

###
POST {{UserRegistration.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "login": "{{login}}",
  "password": "<другой тестовый пароль>"
}

###
GET {{UserRegistration.Api_HostAddress}}/api/users

###
GET {{UserRegistration.Api_HostAddress}}/api/users/{{userId}}

###
GET {{UserRegistration.Api_HostAddress}}/api/users?dateField=createdDate&from={{createdDate}}&to={{createdDate}}

###
GET {{UserRegistration.Api_HostAddress}}/api/users?from=2026-12-01T00:00:00Z&to=2026-01-01T00:00:00Z

###
GET {{UserRegistration.Api_HostAddress}}/api/users?from=not-a-date

###
PUT {{UserRegistration.Api_HostAddress}}/api/users/{{userId}}
Content-Type: application/json

{
  "firstName": "Мария",
  "lastName": "Петрова"
}

###
GET {{UserRegistration.Api_HostAddress}}/api/users?dateField=updatedDate&from={{updatedDate}}&to={{updatedDate}}

###
GET {{UserRegistration.Api_HostAddress}}/api/users/0

###
DELETE {{UserRegistration.Api_HostAddress}}/api/users/{{userId}}

